  m_Script: {fileID: 11500000, guid: 1a633f449938a194e9738ad7bc2507bb, type: 3}
  m_Name: Chat 6
  m_EditorClassIdentifier: 
  textLine:
  - text: The cave system seems to get more complex below this point.
    speaker: 1
  - text: To avoid getting lost, I would recommend taking advantage of the beacons
      in the compartment labeled R of your suit.
    speaker: 1
  - text: You are only holding twenty, but they should be plenty for the size of
      this cave.
    speaker: 1
