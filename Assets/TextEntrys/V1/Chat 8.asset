  m_Script: {fileID: 11500000, guid: 1a633f449938a194e9738ad7bc2507bb, type: 3}
  m_Name: Chat 8
  m_EditorClassIdentifier: 
  textLine:
  - text: I have finished analyzing several of the objects and structures you have
      found so far.
    speaker: 1
  - text: I should be able to upgrade my scanning capabilities to detect nearby points
      of interest in the cave.
    speaker: 1
  - text: If you wish to manually scan, you can do so from the button labeled C in
      your electropanel.
    speaker: 1
