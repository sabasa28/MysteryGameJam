  m_Script: {fileID: 11500000, guid: 1a633f449938a194e9738ad7bc2507bb, type: 3}
  m_Name: Chat 13
  m_EditorClassIdentifier: 
  textLine:
  - text: 'Alright, we made it out. You can speak again MIRA. '
    speaker: 0
  - text: 'Very well. In that case I should tell you: there is something nearby that
      might be of interest.'
    speaker: 1
  - text: Initially I disregarded it in favour of the cave system, but, since we
      are back out, it might be worthwhile to inspect it.
    speaker: 1
  - text: I suggest you do it quickly; this sandstorm is getting more dangerous by
      the minute.
    speaker: 1
  - text: Okay, but, after that, we go back to the ship.
    speaker: 0
